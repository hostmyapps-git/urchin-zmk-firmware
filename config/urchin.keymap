#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "keymap_italian.h"

// Layer definitions
#define BASE 0
#define NUM 1
#define NAV 2
#define BLE 3

&sk {
    // don't release mods on other mods presses
    ignore-modifiers;
};

/ {
    behaviors {
        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_accent {
            timeout-ms = <200>;
            key-positions = <32 33>;
            bindings = <&mo BLE>;
        };
        combo_settings {
            timeout-ms = <200>;
            key-positions = <30 31>;
            bindings = <&mo BLE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Base";
            bindings = <
            &kp Q &kp W &kp E &kp R &kp T             &kp Y &kp U  &kp I     &kp O   &kp P 
            &qt LALT A &qt LCTRL S &qt LGUI D &qt LSHIFT J &kp G             &kp H &qt RSHIFT J &qt RGUI K &qt RCTRL L &qt RALT SEMICOLON
            &kp Z &kp X &kp C &kp V &kp B             &kp N &kp M  &kp COMMA &kp DOT &kp SLASH
                            &lt NUM BSPC &lt NAV SPACE   &lt NAV RETURN &lt NUM BSPC
            >;
        };

        num_layer {
            label = "Num";
            bindings = <
            &kp EXCL &kp AT    &kp HASH  &kp DOLLAR &kp PERCENT    &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR
            &kp N1   &kp N2    &kp N3    &kp N4     &kp N5         &kp N6    &kp N7   &kp N8   &kp N9   &kp N0
            &kp PLUS &kp EQUAL &kp MINUS &kp GRAVE  &kp APOS       &kp LBRC  &kp RBRC &kp LBKT &kp RBKT &kp BACKSLASH
                                         &kp ESC    &mo BLE        &mo BLE   &kp TAB
            >;
        };

        nav_layer {
            label = "Nav";
            bindings = <
            &kp F9 &kp F10 &kp F11 &kp F12 &none      &kp PG_UP &kp HOME &kp UP   &kp END   &kp CAPS
            &kp F5 &kp F6  &kp F7  &kp F8  &none      &kp LEFT  &kp DOWN &kp UP   &kp RIGHT &none
            &kp F1 &kp F2  &kp F3  &kp F4  &none      &none     &none    &none    &none     &none
                                   &mo BLE &none      &none     &mo BLE
            >;
        };

        ble_layer {
            label = "BLE";
            bindings = <
            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR   &bt BT_CLR_ALL &none    &none &none 
            &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4   &none        &none          &none    &none &none
            &studio_unlock &none        &none         &sys_reset    &bootloader     &bootloader  &sys_reset     &unstick &none &none
                                                      &none         &none           &none        &none  
            >;
        };
    };
};
